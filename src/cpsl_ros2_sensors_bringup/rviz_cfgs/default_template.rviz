Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 427
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /default_template/robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      ColorTransformer: FlatColor
      Color: 0; 255; 0
      Enabled: true
      Name: Livox Lidar Points
      Topic:
        Value: /default_template/livox/lidar
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      ColorTransformer: FlatColor
      Color: 0; 0; 255
      Enabled: true
      Name: Ouster Lidar Points
      Topic:
        Value: /default_template/ouster/points
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      ColorTransformer: FlatColor
      Color: 255; 0; 0
      Enabled: true
      Name: Front Radar Points
      Topic:
        Value: /default_template/front_radar/detected_points
      Size (Pixels): 5
      Size (m): 0.02
      Style: Points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      ColorTransformer: FlatColor
      Color: 255; 255; 0
      Enabled: true
      Name: Back Radar Points
      Topic:
        Value: /default_template/back_radar/detected_points
      Size (Pixels): 5
      Size (m): 0.02
      Style: Points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      ColorTransformer: FlatColor
      Color: 255; 0; 255
      Enabled: true
      Name: Down Radar Points
      Topic:
        Value: /default_template/down_radar/detected_points
      Size (Pixels): 5
      Size (m): 0.02
      Style: Points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /default_template/livox/scan
      Size (m): 0.03
      Style: Flat Squares
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: default_template/base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7853
      Yaw: 0.7853
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 731
  Width: 1200
  X: 66
  Y: 32
