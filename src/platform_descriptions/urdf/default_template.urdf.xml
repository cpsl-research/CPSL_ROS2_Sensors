<?xml version="1.0"?>
<robot name="default_template">

    <!-- Robot's base link -->
    <link name="default_template/base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 0.2 0.1"/>
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 0.5"/>
            </material>
        </visual>
    </link>

    <!-- Base link alternative names (without prefix) -->
    <link name="base_link"/>
    <joint name="base_link_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="default_template/base_link"/>
        <child link="base_link"/>
    </joint>

    <link name="base_footprint"/>
